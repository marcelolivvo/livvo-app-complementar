{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/bem-vindo",
      "destination": "/bem-vindo/index.html"
    },
    {
      "source": "/bem-vindo/",
      "destination": "/bem-vindo/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
